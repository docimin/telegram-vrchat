# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your own Telegram user ID (numeric). This account becomes the admin and can create invites.
ADMIN_TELEGRAM_ID=

# Public HTTPS address of this server. Used in pairing links and companion downloads.
PUBLIC_URL=https://vrc.example.com

# Contact info VRChat sees in the companion's User-Agent, required by VRChat's API guidelines.
# Format they ask for: an email address or similar way to reach the app's owner.
VRCHAT_CONTACT=

# Optional
# PORT=8080
# HOST=0.0.0.0
# DATA_DIR=./data
# DIST_DIR=./dist
# TELEGRAM_API_ROOT=https://api.telegram.org

# Only for docker compose: the domain Caddy requests an HTTPS certificate for.
# DOMAIN=vrc.example.com
